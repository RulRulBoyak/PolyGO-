<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PolyGo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/pks_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pks_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/pks_blue</item>
    </style>

    <style name="Theme.PolyGo" parent="Base.Theme.PolyGo">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Widget.PolyGo.GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
        <item name="android:background">@drawable/bg_glass_card</item>
    </style>

    <style name="Widget.PolyGo.PrimaryGradientButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_gradient_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PolyGo.Button</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="ShapeAppearance.PolyGo.Button" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.PolyGo.BentoCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface_variant_light</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="ShapeAppearance.PolyGo.CardImage" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>